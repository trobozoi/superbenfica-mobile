# =============================================================================
# Testes de integração contra a API real (npm run test:integration)
# Copie para `.env.test` (arquivo ignorado pelo git) e preencha.
# Use um usuário com perfil CLIENTE criado só para testes.
# =============================================================================

TEST_API_URL=http://127.0.0.1:8000/
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# "true" libera testes que GRAVAM dados (cria endereço, cria e cancela pedido).
# Deixe "false" em bancos compartilhados.
TEST_ALLOW_WRITES=false
