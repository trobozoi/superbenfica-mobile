# =============================================================================
# Super Benfica Mobile - variáveis de ambiente
# Copie para `.env` e ajuste. Tudo que começa com EXPO_PUBLIC_ vai DENTRO do app
# e pode ser lido por qualquer pessoa que extraia o APK/IPA:
# NUNCA coloque segredos aqui (senha de banco, secret key do Django, tokens...).
# =============================================================================

# development | preview | production
APP_ENV=development

# URL base da API. Troque pela de produção (https://...) quando for publicar.
#  - Simulador iOS:    http://127.0.0.1:8000/
#  - Emulador Android: http://127.0.0.1:8000/ (reescrito para 10.0.2.2 automaticamente)
#  - Celular físico:   http://<IP-da-sua-máquina>:8000/  (ex.: http://192.168.0.10:8000/)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/

# URL do WebSocket. Opcional: se vazio, é derivada da API (http->ws, https->wss).
EXPO_PUBLIC_WS_URL=

# No emulador Android, 127.0.0.1 é o próprio emulador. Com "true" o app troca
# 127.0.0.1/localhost por 10.0.2.2 (a máquina host). Use "false" se preferir
# `adb reverse tcp:8000 tcp:8000`.
EXPO_PUBLIC_ANDROID_LOCALHOST_REWRITE=true

# Preenchido por `eas init` (necessário para push remoto).
EAS_PROJECT_ID=
